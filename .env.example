# EventKalam Environment Configuration Example
# Copy this file to .env and set your credentials.

# Supabase Credentials (optional for local testing, required for production persistence)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Company Information
VITE_COMPANY_NAME="Robokalam Technologies"
VITE_COMPANY_LOCATION="Hanumkonda, Telangana – 506001"
VITE_COMPANY_EMAIL="robokalam@gmail.com"

# Server Port
PORT=3000
